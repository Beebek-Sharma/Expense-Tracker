{
  "info": {
    "name": "Expense Tracker API",
    "description": "Collection covering all endpoints of the Expense Tracker API, including Authentication, Category/Expense CRUD, Currency Conversion, Budget Alerts, Monthly Summaries, Analytics, and CSV Export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "auth_token",
      "value": "your_token_here"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Register a new user and retrieve auth token."
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Authenticate user credentials and obtain auth token."
          }
        },
        {
          "name": "Obtain Token (Standard DRF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            },
            "description": "Standard DRF obtain auth token endpoint."
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            },
            "description": "Returns current authenticated user details."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", ""]
            },
            "description": "Returns all categories for the authenticated user."
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dining\",\n  \"description\": \"Restaurants and takeout\",\n  \"monthly_limit\": \"200.00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", ""]
            },
            "description": "Creates a new category with optional monthly spending limit."
          }
        },
        {
          "name": "Retrieve Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", ""]
            },
            "description": "Retrieves a single category by id."
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monthly_limit\": \"250.00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", ""]
            },
            "description": "Updates a category."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", ""]
            },
            "description": "Deletes a category."
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "List Expenses (Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/?search=shop&category=1&start_date=2026-01-01&end_date=2026-12-31",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", ""],
              "query": [
                { "key": "search", "value": "shop" },
                { "key": "category", "value": "1" },
                { "key": "start_date", "value": "2026-01-01" },
                { "key": "end_date", "value": "2026-12-31" }
              ]
            },
            "description": "Lists all expenses for the user with optional keyword search, category, and date range filters."
          }
        },
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hotel in Paris\",\n  \"amount\": \"120.00\",\n  \"currency\": \"EUR\",\n  \"category\": 1,\n  \"date\": \"2026-06-09\",\n  \"notes\": \"Weekend conference stay\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/expenses/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", ""]
            },
            "description": "Creates a new expense. Supports currency conversion and fires budget alerts if threshold is exceeded."
          }
        },
        {
          "name": "Retrieve Expense",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "1", ""]
            },
            "description": "Retrieves a single expense by id."
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hotel in Paris (Upgraded)\",\n  \"amount\": \"150.00\",\n  \"currency\": \"EUR\",\n  \"category\": 1,\n  \"date\": \"2026-06-09\",\n  \"notes\": \"Room upgrade added\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/expenses/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "1", ""]
            },
            "description": "Updates an expense and recalculates budget alerts."
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "1", ""]
            },
            "description": "Deletes an expense by id."
          }
        }
      ]
    },
    {
      "name": "Reports & Analytics",
      "item": [
        {
          "name": "Expense Summary (By Category)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/summary/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "summary", ""]
            },
            "description": "Returns total spent per category converted into BASE_CURRENCY."
          }
        },
        {
          "name": "Monthly Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/monthly-summary/?month=2026-06",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "monthly-summary", ""],
              "query": [
                { "key": "month", "value": "2026-06" }
              ]
            },
            "description": "Returns monthly spending total converted to BASE_CURRENCY."
          }
        },
        {
          "name": "Analytics Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/analytics/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "analytics", ""]
            },
            "description": "Provides aggregated data for dashboards: 6-month trends, category budget utilization percentages, over-budget indicators."
          }
        },
        {
          "name": "Export Expenses CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/expenses/export/",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses", "export", ""]
            },
            "description": "Exports all expenses as a downloadable CSV."
          }
        }
      ]
    }
  ]
}
