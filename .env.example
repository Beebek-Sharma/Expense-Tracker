# Copy this file to .env and fill in real values.
SECRET_KEY=your-secret-key-here
DEBUG=True

# --- Feature: Currency conversion ---
# Base currency all summaries/totals are reported in (default: USD).
BASE_CURRENCY=USD
# Exchange-rate API base URL (e.g. https://open.er-api.com/v6/latest or https://v6.exchangerate-api.com/v6).
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
# Optional API key if your chosen provider requires one.
EXCHANGE_RATE_API_KEY=

# --- Feature: Budget threshold bot alerts ---
# Telegram bot token from @BotFather.
BOT_TOKEN=your-bot-token-here
# Telegram chat/channel id the alert message is sent to.
BOT_CHAT_ID=your-chat-id-here

# Discord webhook URL for automated budget breach telemetry alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
